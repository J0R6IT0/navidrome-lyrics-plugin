{
  "name": "Lyrics",
  "author": "Jorge Pardo",
  "version": "8.0.0",
  "description": "Fetch lyrics from multiple sources",
  "website": "https://github.com/J0R6IT0/navidrome-lyrics-plugin",

  "permissions": {
    "http": {
      "reason": "To fetch lyrics from the internet. All hosts required for custom URLs.",
      "requiredHosts": ["*"]
    },
    "library": {
      "reason": "To save lyrics as .lrc files.",
      "filesystem": true
    },
    "cache": {
      "reason": "To cache transient provider state (Apple Music dev token, storefront, provider rotation)."
    },
    "kvstore": {
      "reason": "To cache lyrics persistently across restarts.",
      "maxSize": "1000MB"
    }
  },

  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "lyricsFormats": {
          "type": "string",
          "title": "Lyrics formats",
          "default": "ttml,elrc,lyricsfile,lrc,srt,plain",
          "description": "Comma-separated list of formats to fetch, ordered by priority. Remove a format to disable it (not recommended unless you have a specific use case). Valid values: lrc, elrc, ttml, srt, lyricsfile, plain."
        },

        "instrumentalText": {
          "type": "string",
          "title": "Instrumental lyrics text",
          "default": "Instrumental",
          "description": "The text to use for instrumental lyrics. Leave blank to not return instrumental lyrics to navidrome and skip writing them to files."
        },

        "stripSectionLabels": {
          "type": "boolean",
          "title": "Strip section labels ([Verse], [Chorus], etc.)",
          "default": false
        },

        "durationToleranceSeconds": {
          "type": "integer",
          "title": "Duration tolerance (seconds)",
          "minimum": 1,
          "maximum": 3600,
          "default": 3,
          "description": "Maximum allowed difference between the track's duration and a provider result's duration. Increasing this may return less accurate results."
        },

        "requireAlbumMatch": {
          "type": "boolean",
          "title": "Require album match (the track and provider result must have matching albums. Improves accuracy but may reduce matches)",
          "default": false
        },

        "providersList": {
          "type": "array",
          "title": "Lyrics providers (use the \"+\" button to add more)",
          "default": [{ "provider": "lrclib" }, { "provider": "lyrics.ovh" }],
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "title": "Provider",
                "default": "lrclib",
                "oneOf": [
                  { "const": "lrclib", "title": "LRCLIB" },
                  { "const": "lyrics.ovh", "title": "lyrics.ovh" },
                  { "const": "lrcmux", "title": "lrcmux" },
                  { "const": "kugou", "title": "KuGou" },
                  { "const": "netease", "title": "NetEase" },
                  { "const": "qqmusic", "title": "QQ Music" },
                  { "const": "applemusic", "title": "Apple Music" },
                  { "const": "stixoi", "title": "stixoi.info" },
                  { "const": "genie", "title": "Genie Music" },
                  { "const": "binilyrics", "title": "BiniLyrics" }
                ]
              },
              "baseUrl": {
                "type": "string",
                "title": "Custom base URL",
                "description": "Optional. Leave empty to use the provider's default."
              },
              "sources": {
                "type": "array",
                "title": "Sources",
                "uniqueItems": true,
                "default": [
                  "genius",
                  "kugou",
                  "lrclib",
                  "musixmatch",
                  "netease",
                  "ytmusic"
                ],
                "items": {
                  "type": "string",
                  "oneOf": [
                    { "const": "genius", "title": "Genius" },
                    { "const": "kugou", "title": "KuGou" },
                    { "const": "lrclib", "title": "LRCLIB" },
                    { "const": "musixmatch", "title": "Musixmatch" },
                    { "const": "netease", "title": "NetEase" },
                    { "const": "ytmusic", "title": "YouTube Music" }
                  ]
                }
              },
              "mediaUserToken": {
                "type": "string",
                "title": "Media user token",
                "description": "The media-user-token of an Apple Music subscriber, required to access lyrics."
              },
              "storefront": {
                "type": "string",
                "title": "Storefront",
                "description": "Optional. Storefront code (e.g. us, gb, es). Auto-detected from the account when left empty. Only include it if the auto-detection is not working correctly."
              },
              "translationLanguage": {
                "type": "string",
                "title": "Include translation (availability varies by song)",
                "default": "none",
                "oneOf": [
                  { "const": "none", "title": "Off" },
                  { "const": "ca", "title": "Catalan" },
                  { "const": "zh-Hans-CN", "title": "Chinese (Simplified)" },
                  { "const": "en-US", "title": "English" },
                  { "const": "fr-FR", "title": "French" },
                  { "const": "de-DE", "title": "German" },
                  { "const": "it", "title": "Italian" },
                  { "const": "ja", "title": "Japanese" },
                  { "const": "ko", "title": "Korean" },
                  { "const": "pt-BR", "title": "Portuguese" },
                  { "const": "es-MX", "title": "Spanish" }
                ]
              },
              "romanizationScript": {
                "type": "string",
                "title": "Include transliteration (availability varies by song)",
                "default": "none",
                "oneOf": [
                  { "const": "none", "title": "Off" },
                  { "const": "und-Latn", "title": "Latin" },
                  { "const": "und-Hang", "title": "Hangul" },
                  { "const": "und-Kana", "title": "Katakana" }
                ]
              }
            },
            "required": [
              "provider",
              "romanizationScript",
              "translationLanguage"
            ],
            "allOf": [
              {
                "if": {
                  "properties": { "provider": { "const": "applemusic" } },
                  "required": ["provider"]
                },
                "then": { "required": ["mediaUserToken"] }
              }
            ]
          }
        },

        "providerMode": {
          "type": "string",
          "title": "Provider mode",
          "default": "priority",
          "oneOf": [
            { "const": "priority", "title": "Priority" },
            { "const": "rotation", "title": "Rotation" },
            { "const": "type", "title": "Type priority" },
            { "const": "sync", "title": "Best sync level" }
          ]
        },

        "preferUncensored": {
          "type": "boolean",
          "title": "Prefer uncensored lyrics",
          "default": false
        },

        "enableCache": {
          "type": "boolean",
          "title": "Enable lyrics cache",
          "default": true
        },

        "perTypeCacheTtl": {
          "type": "boolean",
          "title": "Use a separate cache TTL per lyrics type",
          "default": false
        },

        "cacheTtlHours": {
          "type": "integer",
          "title": "Cache TTL (hours)",
          "minimum": 1,
          "maximum": 1000000,
          "default": 168,
          "description": "How long cached lyrics remain valid. Default is 7 days."
        },

        "ttmlCacheTtlHours": {
          "type": "integer",
          "title": "TTML cache TTL (hours)",
          "minimum": 1,
          "maximum": 1000000,
          "default": 336,
          "description": "Default is 14 days."
        },

        "lyricsfileCacheTtlHours": {
          "type": "integer",
          "title": "Lyricsfile cache TTL (hours)",
          "minimum": 1,
          "maximum": 1000000,
          "default": 168,
          "description": "Default is 7 days."
        },

        "elrcCacheTtlHours": {
          "type": "integer",
          "title": "ELRC cache TTL (hours)",
          "minimum": 1,
          "maximum": 1000000,
          "default": 336,
          "description": "Default is 14 days."
        },

        "lrcCacheTtlHours": {
          "type": "integer",
          "title": "LRC cache TTL (hours)",
          "minimum": 1,
          "maximum": 1000000,
          "default": 168,
          "description": "Default is 7 days."
        },

        "srtCacheTtlHours": {
          "type": "integer",
          "title": "SRT cache TTL (hours)",
          "minimum": 1,
          "maximum": 1000000,
          "default": 168,
          "description": "Default is 7 days."
        },

        "plainCacheTtlHours": {
          "type": "integer",
          "title": "Plain cache TTL (hours)",
          "minimum": 1,
          "maximum": 1000000,
          "default": 72,
          "description": "Default is 3 days."
        },

        "instrumentalCacheTtlHours": {
          "type": "integer",
          "title": "Instrumental cache TTL (hours)",
          "minimum": 1,
          "maximum": 1000000,
          "default": 336,
          "description": "Default is 14 days."
        },

        "negativeCache": {
          "type": "boolean",
          "title": "Cache negative results (i.e. no lyrics found) (per-provider)",
          "default": true
        },

        "negativeCacheTtlHours": {
          "type": "integer",
          "title": "Negative cache TTL (hours)",
          "minimum": 1,
          "maximum": 1000000,
          "default": 24,
          "description": "How long per-provider negative cache entries remain valid. Default is 24 hours."
        },

        "writeLyrics": {
          "type": "boolean",
          "title": "Write lyrics to sidecar files",
          "default": false
        },

        "plainExtension": {
          "type": "string",
          "title": "Plain lyrics extension",
          "default": "txt",
          "description": "File extension for plain lyrics files. LRC, ELRC, TTML, SRT and YAML files always use their standard extension."
        },

        "instrumentalExtension": {
          "type": "string",
          "title": "Instrumental lyrics extension",
          "default": "txt",
          "description": "File extension for instrumental lyrics files."
        },

        "overwriteLyrics": {
          "type": "boolean",
          "title": "Overwrite existing lyrics files",
          "default": false
        },

        "writeToSpecificFolder": {
          "type": "boolean",
          "title": "Write lyrics to a custom path instead of next to each song file.",
          "default": false
        },

        "writeToSpecificFolderLibraryId": {
          "type": "integer",
          "title": "Library ID",
          "minimum": 0,
          "description": "The library whose root will be used as the base for the output path. Use the numeric ID as shown in Navidrome."
        },

        "writeToSpecificFolderTemplate": {
          "type": "string",
          "title": "Output path template",
          "default": "_lyrics/{type}/{track:album_artist} - {track:album}/{track:disc_number:2} - {track:track_number:2} {track:title}",
          "description": "Path relative to the selected library root. Supports template variables. See GitHub for the full list."
        }
      },
      "required": ["providerMode"],
      "if": {
        "properties": {
          "writeToSpecificFolder": { "const": true }
        },
        "required": ["writeToSpecificFolder"]
      },
      "then": {
        "required": ["writeToSpecificFolderLibraryId"]
      }
    },

    "uiSchema": {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "Group",
          "label": "Lyrics",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/lyricsFormats"
            },
            {
              "type": "Control",
              "scope": "#/properties/durationToleranceSeconds"
            },
            {
              "type": "Control",
              "scope": "#/properties/instrumentalText"
            },
            {
              "type": "Control",
              "scope": "#/properties/stripSectionLabels"
            },
            {
              "type": "Control",
              "scope": "#/properties/requireAlbumMatch"
            }
          ]
        },

        {
          "type": "Group",
          "label": "Providers",
          "elements": [
            {
              "type": "Label",
              "text": "The list of providers to query. The same provider can be included multiple times with different parameters (for example, lrclib with a custom base URL and with the default). The provider mode below controls how the list is used for each lookup."
            },
            {
              "type": "Control",
              "scope": "#/properties/providerMode"
            },
            {
              "type": "Label",
              "text": "• Priority: every lookup tries the providers top to bottom and the first one that returns lyrics wins."
            },
            {
              "type": "Label",
              "text": "• Rotation: each lookup starts with the next provider in the list, cycling through them on successive calls. If the chosen provider returns nothing, the rest are tried as fallbacks. Useful to avoid rate limits."
            },
            {
              "type": "Label",
              "text": "• Type priority: keeps querying providers until it has the highest-priority format they can offer, then returns the best result. Skips providers that cannot beat what is already fetched. Ties go to the higher provider. More requests per lookup."
            },
            {
              "type": "Label",
              "text": "• Best sync level: same as type priority, but ranks results by their sync level (word-by-word > line-by-line > plain). More requests per lookup."
            },
            {
              "type": "Control",
              "scope": "#/properties/preferUncensored",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/providerMode",
                  "schema": {
                    "enum": ["type", "sync"]
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/providersList",
              "options": {
                "showSortButtons": true,
                "elementLabelProp": "provider",
                "detail": {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/provider"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/baseUrl",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/provider",
                          "schema": {
                            "enum": ["lrclib", "lyrics.ovh", "lrcmux"]
                          }
                        }
                      }
                    },
                    {
                      "type": "Label",
                      "text": "Sources",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/provider",
                          "schema": {
                            "const": "lrcmux"
                          }
                        }
                      }
                    },
                    {
                      "type": "VerticalLayout",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/provider",
                          "schema": {
                            "const": "lrcmux"
                          }
                        }
                      },
                      "elements": [
                        {
                          "type": "Control",
                          "scope": "#/properties/sources",
                          "label": false
                        }
                      ]
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/mediaUserToken",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/provider",
                          "schema": {
                            "const": "applemusic"
                          }
                        }
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/storefront",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/provider",
                          "schema": {
                            "const": "applemusic"
                          }
                        }
                      }
                    },

                    {
                      "type": "HorizontalLayout",
                      "elements": [
                        {
                          "type": "Control",
                          "scope": "#/properties/romanizationScript",
                          "rule": {
                            "effect": "SHOW",
                            "condition": {
                              "scope": "#/properties/provider",
                              "schema": {
                                "const": "applemusic"
                              }
                            }
                          }
                        },
                        {
                          "type": "Control",
                          "scope": "#/properties/translationLanguage",
                          "rule": {
                            "effect": "SHOW",
                            "condition": {
                              "scope": "#/properties/provider",
                              "schema": {
                                "const": "applemusic"
                              }
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },

        {
          "type": "Group",
          "label": "Cache",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/enableCache"
            },
            {
              "type": "Control",
              "scope": "#/properties/cacheTtlHours",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "enableCache": {
                        "const": true
                      },
                      "perTypeCacheTtl": {
                        "const": false
                      }
                    },
                    "required": ["enableCache"]
                  }
                }
              }
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/ttmlCacheTtlHours"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/lyricsfileCacheTtlHours"
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "enableCache": {
                        "const": true
                      },
                      "perTypeCacheTtl": {
                        "const": true
                      }
                    },
                    "required": ["enableCache", "perTypeCacheTtl"]
                  }
                }
              }
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/elrcCacheTtlHours"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/lrcCacheTtlHours"
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "enableCache": {
                        "const": true
                      },
                      "perTypeCacheTtl": {
                        "const": true
                      }
                    },
                    "required": ["enableCache", "perTypeCacheTtl"]
                  }
                }
              }
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/srtCacheTtlHours"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/plainCacheTtlHours"
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "enableCache": {
                        "const": true
                      },
                      "perTypeCacheTtl": {
                        "const": true
                      }
                    },
                    "required": ["enableCache", "perTypeCacheTtl"]
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/instrumentalCacheTtlHours",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "enableCache": {
                        "const": true
                      },
                      "perTypeCacheTtl": {
                        "const": true
                      }
                    },
                    "required": ["enableCache", "perTypeCacheTtl"]
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/negativeCache",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/enableCache",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/negativeCacheTtlHours",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "enableCache": {
                        "const": true
                      },
                      "negativeCache": {
                        "const": true
                      }
                    },
                    "required": ["enableCache", "negativeCache"]
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/perTypeCacheTtl",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/enableCache",
                  "schema": {
                    "const": true
                  }
                }
              }
            }
          ]
        },

        {
          "type": "Group",
          "label": "File Writing",
          "elements": [
            {
              "type": "Label",
              "text": "NOTE: Your music library must be mounted with write access and the plugin must have permission to write files."
            },
            {
              "type": "Control",
              "scope": "#/properties/writeLyrics"
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/plainExtension"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/instrumentalExtension"
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/writeLyrics",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/overwriteLyrics",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/writeLyrics",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/writeToSpecificFolder",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/writeLyrics",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/writeToSpecificFolderLibraryId",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "writeLyrics": {
                        "const": true
                      },
                      "writeToSpecificFolder": {
                        "const": true
                      }
                    },
                    "required": ["writeLyrics", "writeToSpecificFolder"]
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/writeToSpecificFolderTemplate",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "writeLyrics": {
                        "const": true
                      },
                      "writeToSpecificFolder": {
                        "const": true
                      }
                    },
                    "required": ["writeLyrics", "writeToSpecificFolder"]
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
